#!/bin/bash
#
# GreenMind Installer for Raspberry Pi OS (Bookworm or newer, Lite or Desktop)
#
# Usage:
#   bash greenmind_installer
#
# Optional environment variables:
#   GM_REF           git branch or tag of GreenMind to install (default: v2.0)
#   NODERED_VERSION  Node-RED version to install (default: 5.0.8)
#

set -euo pipefail

GM_REF="${GM_REF:-v2.0}"
NODERED_VERSION="${NODERED_VERSION:-5.0.8}"
GM_RAW="https://raw.githubusercontent.com/ThomasAndreini/GreenMind/${GM_REF}"
NODERED_DIR="${HOME}/.node-red"
GM_DATA_DIR="${HOME}/greenmind"

fail() {
    echo "ERROR: $1" >&2
    exit 1
}

download() {
    # download <url> <destination>
    curl -fsSL -o "$2" "$1" || fail "Failed to download $1, check your internet connection"
}

echo "GreenMind installer (ref: ${GM_REF}, Node-RED ${NODERED_VERSION})"

command -v curl >/dev/null 2>&1 || fail "curl is required, install it with: sudo apt install curl"

# Create Node-RED user directory, the folder of the flow and the data folder (sqlite db)
mkdir -p "${NODERED_DIR}/greenmind" || fail "Failed to create ${NODERED_DIR}, check permissions"
mkdir -p "${GM_DATA_DIR}" || fail "Failed to create ${GM_DATA_DIR}, check permissions"

# Install Node.js 22 LTS and Node-RED using the official installer
NR_INSTALLER="$(mktemp)"
trap 'rm -f "${NR_INSTALLER}"' EXIT
download "https://raw.githubusercontent.com/node-red/linux-installers/master/deb/update-nodejs-and-nodered" "${NR_INSTALLER}"
bash "${NR_INSTALLER}" --confirm-install --confirm-pi --node22 --nodered-version="${NODERED_VERSION}" \
    || fail "Node-RED installation failed, check /var/log/nodered-install.log for more details"
echo "Node-RED installed"

# Stop Node-RED (if running) while GreenMind files are copied
sudo systemctl stop nodered.service 2>/dev/null || true

# Raspberry Pi 5 does not support the legacy RPi.GPIO library used by node-red-node-pi-gpio,
# python3-rpi-lgpio provides a compatible replacement
if grep -qs "Raspberry Pi 5" /proc/device-tree/model; then
    echo "Raspberry Pi 5 detected, installing python3-rpi-lgpio"
    sudo apt-get install -y python3-rpi-lgpio || fail "Failed to install python3-rpi-lgpio"
fi

# Download GreenMind files
download "${GM_RAW}/greenmind.json" "${NODERED_DIR}/greenmind/greenmind.json"
download "${GM_RAW}/installer/settings.js" "${NODERED_DIR}/settings.js"
download "${GM_RAW}/package.json" "${NODERED_DIR}/package.json"
echo "GreenMind files downloaded"

# Install the extra nodes required by GreenMind
cd "${NODERED_DIR}"
npm install --omit=dev --no-audit --no-fund || fail "Can't install extra nodes"
echo "Extra nodes installed"

# Run Node-RED at startup and start it
sudo systemctl enable nodered.service
sudo systemctl start nodered.service

IP_ADDR="$(hostname -I 2>/dev/null | awk '{print $1}')"
echo ""
echo "GreenMind is installed successfully"
echo "  Dashboard: http://${IP_ADDR:-<raspberry-ip>}:1880/dashboard"
echo "  Editor:    http://${IP_ADDR:-<raspberry-ip>}:1880"
